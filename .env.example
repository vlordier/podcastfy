# podcastfy — Environment Configuration
#
# Copy this file to .env and fill in your API keys.
# At least one LLM API key is required.

# === Required (at least one) ===
# Google Gemini API key for content generation and TTS
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI API key for content generation
OPENAI_API_KEY=your_openai_api_key_here

# === Optional ===
# ElevenLabs API key for TTS (used if tts_model="elevenlabs")
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Jina API key for web content extraction (optional, free tier available)
JINA_API_KEY=your_jina_api_key_here
# Podcastfy API key for FastAPI authentication (if using the API server)
PODCASTFY_API_KEY=your_api_key_here